            outbound_event_type AS event_type
        FROM sales_drilldown WHERE outbound_event_type = 'opp_created' AND acc_tags IS NOT NULL
        GROUP BY GROUPING SETS ((outbound_year, outbound_endofweek, event_type), (outbound_year, outbound_quarter, event_type))
    
