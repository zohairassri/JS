WITH market_source AS (
    SELECT * FROM (
    SELECT acc_name, acc_id, dom.first_touch_timestamp, dom.first_touch_source, dom.utm_parameters
       FROM segment_activity_by_domain dom
       JOIN
           ( SELECT id AS acc_id, display_name AS acc_name, UNNEST(domains) AS acc_domain FROM dim_account_slim ) AS acc ON acc.acc_domain = dom.domain
       WHERE job_execution_timestamp = (SELECT MAX(job_execution_timestamp) FROM segment_activity_by_domain)
       ) AS mkt_source
    JOIN sales_drilldown AS sales_drl_down ON sales_drl_down.account_id = mkt_source.acc_id    
 ),

