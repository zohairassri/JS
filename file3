(SELECT 
    user, domain, utm_source, campaign_type,
    year, endofweek, quarter,
    MIN (timestamp) AS first_touchpoint_timestamp,
    COUNT(touchpoint_number) AS total_touchpoints, COUNT (DISTINCT utm_source) AS total_utm_source,
    COUNT (DISTINCT utm_medium) AS total_utm_medium, COUNT (DISTINCT utm_campaign) AS total_utm_campaign,
    COUNT (DISTINCT utm_term) AS total_utm_term, COUNT (DISTINCT utm_content) AS total_utm_content
FROM marketing_touchpoints
--Using GROUPING SETS  aggregation to get count based on user and domain is performed separately. 
--Besides this, aggregation is performed using a combination of other fields used in the calendar table.

