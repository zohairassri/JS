        FROM sales_drilldown WHERE opp_state != 'closed' AND acc_tags IS NOT NULL AND outbound_event_type = 'opp_created'
        GROUP BY GROUPING SETS ((year, endofweek, event_type), (year, quarter, event_type))
        
),

