-- This view stores all opportunity related details associated with an account ie its owner, created date,
-- close date, etc. It uses tables dim_opportunity, dim_devu and dim_account_slim. In this query, endofweek, month,
-- and quarter are computed for target close date and actual close date
CREATE OR REPLACE TABLE opportunity AS
WITH valid_opportunity AS (
  -- Open opportunities
  SELECT id, account_id, title, body, 
      created_date, target_close_date, actual_close_date, 
      state, tags_json, amount, annual_recurring_revenue, CAST(annual_recurring_revenue AS DOUBLE) AS acv,
      display_id AS eng_display_id, owned_by_ids,JSON_EXTRACT_STRING(stage_json, '$.name') AS stage_name,
      forecast_category AS forecast_category_enum,
      CASE
          WHEN forecast_category = 1 THEN 'omitted'
          WHEN forecast_category = 2 THEN 'pipeline'
          WHEN forecast_category = 5 THEN 'commit'
          WHEN forecast_category = 6 THEN 'won'
          WHEN forecast_category = 7 THEN 'upside'
          WHEN forecast_category = 8 THEN 'strong_upside' 
      END AS forecast_category, 
      ROW_NUMBER() OVER (PARTITION BY account_id ORDER BY created_date) AS opp_num
  FROM dim_opportunity
  WHERE state != 'closed' 
-- Closed won opportunities
  UNION ALL
  SELECT id, account_id, title, body, 
      created_date,  target_close_date, actual_close_date, 
      state, tags_json, amount, annual_recurring_revenue, CAST(annual_recurring_revenue AS DOUBLE) AS acv,
      display_id AS eng_display_id, owned_by_ids, JSON_EXTRACT_STRING(stage_json, '$.name') AS stage_name,
      forecast_category AS forecast_category_enum,
      'won' AS forecast_category,
      ROW_NUMBER() OVER (PARTITION BY account_id ORDER BY created_date) AS opp_num
  FROM dim_opportunity
  WHERE (stage_name IN ('closed_won')) OR (state = 'closed' AND forecast_category_enum = 6)  
  --Closed lost opportunities  
  UNION ALL
  SELECT id, account_id, title, body, 
      created_date,  target_close_date, actual_close_date, 
      state, tags_json, amount, annual_recurring_revenue, CAST(annual_recurring_revenue AS DOUBLE) AS acv,
      display_id AS eng_display_id, owned_by_ids, JSON_EXTRACT_STRING(stage_json, '$.name') AS stage_name,
      forecast_category AS forecast_category_enum,
      'lost' AS forecast_category,
      ROW_NUMBER() OVER (PARTITION BY account_id ORDER BY created_date) AS opp_num
  FROM dim_opportunity
  WHERE stage_name IN ('closed_lost')
),
owners_unnested AS (
  SELECT id, unnest(owned_by_ids) AS owner_id
  FROM valid_opportunity
),
owners_table AS (
  SELECT id, string_agg(owner_id, ', ') AS owner_ids, string_agg(fullname, ', ') AS owners, string_agg(email, ', ') AS owner_emails
  FROM (
    SELECT owner.id, owner_id, fullname, email
    FROM owners_unnested owner join  dim_devu devu ON owner.owner_id = devu.id
    WHERE owner.owner_id like '%devu%'
)
GROUP BY id
),
valid_opportunity_with_owners AS (
  SELECT val_opp.*, owners, owner_emails, owner_ids
  FROM valid_opportunity val_opp LEFT JOIN owners_table owner ON val_opp.id = owner.id 
),
aggregate_opp AS (
  SELECT account_id, SUM(acv) AS total_arr, COUNT(id) AS total_opps
  FROM valid_opportunity_with_owners 
  GROUP BY account_id
)
--Open opportunities fields
SELECT activity.account_id, acc_display_id, account_name, activity.id AS opp_id, eng_display_id, owners, owner_ids,
  created_date, activity.target_close_date, actual_close_date,
  datepart('year', target_close_date) AS year, datepart('month', target_close_date) AS month, datepart('week', target_close_date) AS week,
  strftime('%m/%d/%Y', date '2017-12-31' + (cast(floor(date_diff('day', date '2017-12-31', target_close_date)/7) +1 AS int) * 7)) AS endofweek,
  CASE datepart('month', target_close_date)
    WHEN 1 THEN 'Q4' 
    WHEN 2 THEN 'Q1' WHEN 3 THEN 'Q1' WHEN 4 THEN 'Q1' 
    WHEN 5 THEN 'Q2' WHEN 6 THEN 'Q2' WHEN 7 THEN 'Q2' 
    WHEN 8 THEN 'Q3' WHEN 9 THEN 'Q3' WHEN 10 THEN 'Q3' 
    WHEN 11 THEN 'Q4' WHEN 12 THEN 'Q4'
  END AS quarter,
  CASE
    WHEN forecast_category_enum = 2 THEN 0.4
    WHEN forecast_category_enum = 5 THEN 0.7
    WHEN forecast_category_enum = 7 THEN 0.9
    WHEN forecast_category_enum = 8 THEN 0.95
    ELSE 1 -- Default weight when none of the above cases apply
  END AS arr_multiplier, 
  forecast_category, forecast_category_enum, state, annual_recurring_revenue, acv, total_arr, total_opps, stage_name
  FROM (SELECT * FROM valid_opportunity_with_owners) AS activity,(SELECT id AS account_id, display_id AS acc_display_id, display_name AS account_name FROM dim_account_slim ) acct,
  aggregate_opp AS agg_opp
  WHERE activity.account_id = acct.account_id AND target_close_date != '0001-01-01 00:00:00 UTC' AND agg_opp.account_id = activity.account_id AND state!= 'closed'
  UNION ALL
  --Closed opportunities fields
  SELECT activity.account_id, acc_display_id, account_name, activity.id AS opp_id, eng_display_id, owners, owner_ids,
  created_date, activity.target_close_date, actual_close_date,
  datepart('year', actual_close_date) AS year, datepart('month', actual_close_date) AS month, datepart('week', actual_close_date) AS week,
  strftime('%m/%d/%Y', date '2017-12-31' + (cast(floor(date_diff('day', date '2017-12-31', actual_close_date)/7) +1 AS int) * 7)) AS endofweek,
  CASE datepart('month', actual_close_date)
    WHEN 1 THEN 'Q4' 
    WHEN 2 THEN 'Q1' WHEN 3 THEN 'Q1' WHEN 4 THEN 'Q1' 
    WHEN 5 THEN 'Q2' WHEN 6 THEN 'Q2' WHEN 7 THEN 'Q2' 
    WHEN 8 THEN 'Q3' WHEN 9 THEN 'Q3' WHEN 10 THEN 'Q3' 
    WHEN 11 THEN 'Q4' WHEN 12 THEN 'Q4'
  END AS quarter, 1 AS arr_multiplier, 
  forecast_category, forecast_category_enum, state, annual_recurring_revenue, acv, total_arr, total_opps, stage_name
  FROM (SELECT * FROM valid_opportunity_with_owners) AS activity,(SELECT id AS account_id, display_id AS acc_display_id, display_name AS account_name FROM dim_account_slim ) acct,
  aggregate_opp AS agg_opp
  WHERE activity.account_id = acct.account_id AND agg_opp.account_id = activity.account_id AND state = 'closed'
  ORDER BY activity.account_id, target_close_date
