)
SELECT *,
    CASE 
        WHEN quarter IS NULL AND endofweek IS NOT NULL THEN 'weekly'
        WHEN endofweek IS NULL AND quarter IS NOT NULL THEN 'quarterly'
        ELSE NULL
    END AS set
FROM rollups 
