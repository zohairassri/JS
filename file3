 ORDER BY endofweek, year, quarter, set`,ele=`--This block calculates total dollar ARR for each stage of open opportunity and overall sum of ARR across all open opportunities using GROUPING SETS
    WITH stage_sum_open_sum AS (
      SELECT 'weekly' AS set, year, null AS quarter, endofweek, 
       forecast_category AS event_type, SUM(arr * arr_multiplier) AS num
      FROM sales_drilldown
      WHERE opp_state != 'closed' AND event_type != 'omitted' AND outbound_event_type = 'opp_created' 
      GROUP BY GROUPING SETS ((year, endofweek, event_type), (year, endofweek))
      UNION ALL
      SELECT 'quarterly' AS set, year, quarter, null AS endofweek,
        forecast_category AS event_type, SUM(arr * arr_multiplier) AS num
      FROM sales_drilldown
      WHERE opp_state != 'closed' AND event_type != 'omitted' AND outbound_event_type = 'opp_created' 
      GROUP BY GROUPING SETS ((year, quarter, event_type), (year, quarter))
      UNION ALL
      SELECT 'weekly' AS set, year, null AS quarter, endofweek, 
      'won' event_type,
      SUM(arr) AS num
      FROM sales_drilldown
      WHERE ((forecast_category = 'won' AND opp_state = 'closed') OR (opp_stage_name IN ('closed_won')) ) AND outbound_event_type = 'opp_created' 
      GROUP BY GROUPING SETS ((year, endofweek, event_type))
      UNION ALL
      SELECT 'quarterly' AS set, year, quarter, null AS endofweek,
      'won' AS event_type,
      SUM(arr) AS num
      FROM sales_drilldown
      WHERE ((forecast_category = 'won' AND opp_state = 'closed') OR (opp_stage_name IN ('closed_won')) ) AND outbound_event_type = 'opp_created' 
      AND quarter != 'Q4' --to be removed later
      GROUP BY GROUPING SETS ((year, quarter, event_type))
      UNION ALL
      SELECT 'weekly' AS set, year, null AS quarter, endofweek, 
      'lost' AS event_type,
      SUM(arr) AS num
      FROM sales_drilldown
      WHERE (forecast_category = 'lost' OR (opp_stage_name IN ('closed_lost')))  AND opp_state = 'closed' AND outbound_event_type = 'opp_created' 
      GROUP BY year, endofweek, event_type
      UNION ALL
      SELECT 'quarterly' AS set, year, quarter, null AS endofweek,
      'lost' AS event_type,
      SUM(arr) AS num
      FROM sales_drilldown
      WHERE(forecast_category = 'lost' OR (opp_stage_name IN ('closed_lost'))) AND opp_state = 'closed' AND outbound_event_type = 'opp_created' 
      AND quarter != 'Q4' --to be removed later
      GROUP BY year, quarter, event_type
      ORDER BY set, year desc, quarter desc, endofweek desc, event_type
    ),
    --This block of code calculates the Grand Total which is a some of total ARR across open opportunities and won opportunities
    won_open_sum AS (
      SELECT *  EXCLUDE(num, event_type), SUM(num) AS num, 'overall_total' AS flag FROM stage_sum_open_sum
      WHERE event_type is not null and event_type !='lost'
      GROUP BY GROUPING SETS ((year,endofweek,set),(year, quarter, quarter,set))
    )
    --Combining the previous two blocks of code using UNION
    SELECT * 
