-- This view stores record of all engagements( and meetings) for a given account along with
-- Info like meeting schedule date, attendees (devs and revs and dev roles)
-- It uses tables dim_opportunity, dim_account_slim, dim_devu, dim_revu_slim and dim_engagement
CREATE OR REPLACE TABLE engagement AS
WITH valid_meeting AS (
  SELECT id AS meeting_id, display_id AS eng_display_id, parent_id AS account_id, engagement_type, 
    scheduled_date AS timestamp, JSON_EXTRACT(meeting_summary_json, '$.state') AS meeting_state_enum,
    member_ids, title, tags_json, created_date AS created_timestamp
  FROM dim_engagement e 
),  
members_unnested AS (
  SELECT meeting_id, UNNEST(member_ids) AS member_id
  FROM valid_meeting
),
dev_users AS (
  SELECT meeting_id, string_agg(email, ', ') AS dev_emails, string_agg(fullname, ', ') AS dev_names, string_agg(member_id, ', ') AS dev_ids, string_agg(dev_role, ', ') AS dev_roles 
  FROM (
     SELECT meeting_id, member_id, email, fullname, REGEXP_REPLACE(job_title, '^.*JobTitleEnum', '') AS dev_role
     FROM members_unnested m join dim_devu u ON m.member_id = u.id
     WHERE m.member_id like '%devu%'
  )
  GROUP BY meeting_id
),
rev_users AS (
  SELECT meeting_id, string_agg(fullname, ', ') AS rev_emails, string_agg(fullname, ', ') AS rev_names, string_agg(member_id, ', ') AS rev_ids, 
  FROM (
    SELECT meeting_id, member_id, fullname
    FROM members_unnested m LEFT JOIN ( 
      SELECT id AS rev_id, 
        CASE 
          WHEN full_name IS NOT NULL AND full_name !='' THEN full_name
          WHEN (full_name IS NULL OR full_name = '') AND (display_name IS NOT NULL AND display_name != '') THEN display_name
          WHEN display_name IS NULL OR full_name IS NULL OR full_name = '' THEN email
        END AS fullname 
      FROM dim_revu_slim
    ) u ON m.member_id = u.rev_id
   WHERE m.member_id like '%revu%'
 )
 GROUP BY meeting_id
),
valid_meeting_with_members AS (
SELECT m.*, dev_emails, dev_names, dev_roles, rev_emails, rev_names, dev_ids, rev_ids
FROM valid_meeting m LEFT JOIN dev_users d ON m.meeting_id = d.meeting_id 
LEFT JOIN rev_users r ON m.meeting_id = r.meeting_id 
)
SELECT *,
  CASE 
    WHEN meeting_state_enum = 0 THEN 'Unknown'
    WHEN meeting_state_enum = 1 THEN 'Scheduled'
    WHEN meeting_state_enum = 2 THEN 'Canceled'
    WHEN meeting_state_enum = 3 THEN 'Completed'
  END AS meeting_state,
  COUNT(CASE WHEN engagement_type = 1 THEN 1 END) OVER (PARTITION BY account_id ORDER BY timestamp ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS meeting_num,
  COUNT(CASE WHEN engagement_type = 1 THEN 1 END) OVER (PARTITION BY account_id ORDER BY timestamp DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS max_meeting_num
FROM valid_meeting_with_members
`,`
-- This view stores all sales related milestines such as 1st meeting, opportunity created and closed which are useful for
-- sales putbound grow command
-- This view plays an important role in sales outbound command. 
-- It uses opportunity query and engagement query defined previously
CREATE OR REPLACE TABLE sales_activity AS
WITH sales_activity AS (
  SELECT activity.account_id, acc_display_id, account_name, activity.event_type, activity.engagement_id, activity.created_timestamp, activity.target_close_date, activity.dev_names, activity.rev_names, activity.annual_recurring_revenue, activity.acv, activity.eng_display_id, activity.owners, activity.owner_ids, activity.meeting_num,
  activity.timestamp, datepart('year', timestamp) AS year, datepart('month', timestamp) AS month, datepart('week', timestamp) AS week,
  strftime('%m/%d/%Y', date '2017-12-31' + (cast(floor(date_diff('day', date '2017-12-31', timestamp)/7) +1 AS int) * 7)) AS endofweek,
  CASE datepart('month', timestamp)
    WHEN 1 THEN 'Q4' 
    WHEN 2 THEN 'Q1' WHEN 3 THEN 'Q1' WHEN 4 THEN 'Q1' 
    WHEN 5 THEN 'Q2' WHEN 6 THEN 'Q2' WHEN 7 THEN 'Q2' 
    WHEN 8 THEN 'Q3' WHEN 9 THEN 'Q3' WHEN 10 THEN 'Q3' 
    WHEN 11 THEN 'Q4' WHEN 12 THEN 'Q4' 
  END AS quarter, ROW_NUMBER() OVER (PARTITION BY activity.account_id ORDER BY timestamp) AS row_num, 
  date_diff('day' , (first_value(timestamp) over (PARTITION BY activity.account_id ORDER BY timestamp)) , timestamp) AS age

  FROM (
      SELECT account_id, created_date AS timestamp, '' AS created_timestamp, target_close_date, opp_id AS engagement_id, 'opp_created' AS event_type, '' AS dev_names, '' AS rev_names, annual_recurring_revenue, acv, eng_display_id, owners, owner_ids,  1 AS meeting_num
      FROM (SELECT * FROM opportunity)
      UNION ALL
      SELECT account_id, actual_close_date AS timestamp, '' AS created_timestamp, target_close_date, opp_id AS engagement_id, 'opp_closed_won' AS event_type, '' AS dev_names, '' AS rev_names, annual_recurring_revenue, acv, eng_display_id, owners, owner_ids, 1 AS meeting_num
      FROM (SELECT * FROM opportunity)
      WHERE (stage_name IN ('closed_won')) OR (state = 'closed' AND forecast_category_enum = 6) 
      UNION ALL
      SELECT account_id, actual_close_date AS timestamp, '' AS created_timestamp, target_close_date, opp_id AS engagement_id, 'opp_closed_lost' AS event_type,  '' AS dev_names, '' AS rev_names, annual_recurring_revenue, acv, eng_display_id, owners, owner_ids, 1 AS meeting_num
      FROM (SELECT * FROM opportunity)
      WHERE stage_name IN ('closed_lost')
      UNION ALL
      SELECT account_id, timestamp, created_timestamp, '' AS target_close_date, meeting_id AS engagement_id, 'meeting_scheduled' AS event_type, dev_names, rev_names, '' AS annual_recurring_revenue, '' AS acv, eng_display_id, '' AS owners, '' AS owner_ids, meeting_num
      FROM (SELECT * FROM engagement WHERE meeting_num = 1 AND engagement_type = 1)
      UNION ALL
      SELECT account_id, created_timestamp AS timestamp, '' AS created_timestamp, '' AS target_close_date, meeting_id AS engagement_id, 'meeting_booked' AS event_type, dev_names, rev_names, '' AS annual_recurring_revenue, '' AS acv, eng_display_id, '' AS owners, '' AS owner_ids, meeting_num
      FROM (SELECT * FROM engagement WHERE meeting_num = 1 AND engagement_type = 1)
  ) activity, (SELECT id AS account_id, display_name AS account_name, display_id AS acc_display_id FROM dim_account_slim) a
  WHERE activity.account_id = a.account_id
  ORDER BY activity.account_id, timestamp
)
SELECT * FROM sales_activity
`,`
--This is a master table which is used to render output for calendar tables (funnels) and analytical tables (drilldowns)
CREATE OR REPLACE TABLE sales_drilldown AS
--Get all engagements ordered in chronological order and partitioned by parent_id (account_id)
WITH account_engagements AS (
  SELECT *, 
  ROW_NUMBER() OVER(PARTITION BY parent_id ORDER BY scheduled_date) AS eng_num,
  CASE
      WHEN engagement_type = 1 THEN 'Meeting' 
      WHEN engagement_type = 2 THEN 'Survey'
      WHEN engagement_type = 3 THEN 'Default'
      WHEN engagement_type = 4 THEN 'LinkedIn'
      WHEN engagement_type = 5 THEN 'Call'
      WHEN engagement_type = 6 THEN 'Offline'
      WHEN engagement_type = 7 THEN 'Email'
      ELSE 'Unknown'
  END AS engagement_label
  FROM dim_engagement
),
--Capturing all 1st engagements for an account id
first_engagement AS (
  SELECT parent_id AS account_id, id, engagement_label AS first_eng_type, account_engagements.member_ids AS first_eng_members, 
      dev_names AS first_eng_devs, dev_roles AS first_eng_dev_roles, rev_names AS first_eng_revs, scheduled_date AS first_eng_date 
  FROM account_engagements
  LEFT JOIN engagement AS eng_view ON id = eng_view.meeting_id 
  WHERE eng_num = 1
),
--Capturing all meetings for an account id
meetings AS (
  SELECT parent_id AS account_id, id, account_engagements.member_ids AS meeting_members, 
      dev_names, dev_roles, rev_names, created_date AS meeting_booked_date, scheduled_date AS meeting_date,
  ROW_NUMBER() OVER(PARTITION BY parent_id ORDER BY scheduled_date) AS meeting_num, meeting_state
  FROM account_engagements
  LEFT JOIN engagement AS eng_view ON account_engagements.id = eng_view.meeting_id 
  WHERE account_engagements.engagement_type = 1
),
--Capturing all 1st meetings for an account id
first_meeting AS (
  SELECT account_id, id, meeting_members AS first_meeting_members, dev_names AS first_meet_devs, dev_roles AS first_meeting_dev_roles, rev_names AS first_meet_revs,
  meeting_booked_date AS first_meeting_booked_date, meeting_date AS first_meeting_date, meeting_state
  FROM meetings
  WHERE meeting_num = 1
),
--Aggregating all engagements between 1st engagement and 1st meeting
aggregate_engagements AS (
  SELECT parent_id AS account_id,
  STRING_AGG(acct_eng.engagement_label, ', ') AS engagements_in_between, 
  COUNT(acct_eng.id) AS total_eng_between
  FROM account_engagements AS acct_eng
  LEFT JOIN first_engagement AS first_eng ON acct_eng.parent_id = first_eng.account_id 
  LEFT JOIN first_meeting AS fst_meet ON acct_eng.parent_id = fst_meet.account_id
  WHERE scheduled_date > first_eng_date AND scheduled_date < first_meeting_booked_date
  GROUP BY parent_id
),
--To clean the industries custom field and aggregate it in an array
industries AS (
  SELECT id, string_agg(unnested_field, ', ') AS acc_industries
  FROM(
      SELECT id, REPLACE(unnest(industries), '"', '') AS unnested_field
      FROM dim_account_custom_fields
  )
  GROUP BY id
),
--Assigning tag names to tag ids associated with an account
account_tags AS (
  SELECT id, display_name, JSON_EXTRACT(extracted, 'tag_id') AS tag_id 
  FROM (SELECT id,display_name, UNNEST(JSON_EXTRACT(tags_json, '$[*]')) AS extracted FROM dim_account_slim)
),
accounts_with_tag_names AS (
  SELECT acct.id AS account_id, display_name AS account_name, tag_id, name AS tag_name 
  FROM account_tags acct, dim_tag  t 
  WHERE acct.tag_id = CONCAT('"',t.id, '"') AND (name like '%event%'OR regexp_matches(name, '[0-9]{2,4}') ) AND lower(name) not like '%meeting%'

  ORDER BY acct.display_name
),
deduped_accounts_with_tag_names AS (
  SELECT account_id, string_agg(tag_name, ', ') AS account_tags 
  FROM accounts_with_tag_names 
  GROUP BY account_id
)

--Output of final engagements table with fields ordered in order of events that occur

